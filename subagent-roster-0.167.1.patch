+#[tokio::test]
+async fn existing_primary_attach_restores_main_liveness_from_turns() -> Result<()> {
+    let mut app = make_test_app().await;
+    let app_server = Box::pin(crate::start_embedded_app_server_for_picker(&app.config)).await?;
+    let main = ThreadId::new();
+    let child = ThreadId::new();
+    app.agent_navigation.upsert(child, None, None, false);
+    app.agent_navigation.record_parent(child, main);
+    for status in [TurnStatus::InProgress, TurnStatus::Completed] {
+        app.attach_existing_primary_thread_session(
+            &app_server,
+            test_thread_session(main, app.config.cwd.to_path_buf()),
+            vec![test_turn("resumed-turn", status.clone(), Vec::new())],
+        )
+        .await?;
+        let expected = if status == TurnStatus::InProgress {
+            crate::agent_roster::AgentRosterStatus::Running
+        } else {
+            crate::agent_roster::AgentRosterStatus::Idle
+        };
+        for displayed in [main, child] {
+            let roster = app.agent_navigation.roster(Some(main), Some(displayed));
+            assert_eq!(roster.rows[0].status, expected);
+        }
+    }
+    app.attach_existing_primary_thread_session(
+        &app_server,
+        test_thread_session(main, app.config.cwd.to_path_buf()),
+        Vec::new(),
+    )
+    .await?;
+    assert_eq!(
+        app.agent_navigation.roster(Some(main), Some(main)).rows[0].status,
+        crate::agent_roster::AgentRosterStatus::Idle
+    );
+    Ok(())
+}
