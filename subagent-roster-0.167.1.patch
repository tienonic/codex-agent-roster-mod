 impl AgentNavigationState {
+    pub(crate) fn record_parent(&mut self, child: ThreadId, parent: ThreadId) {
+        if child != parent {
+            self.parents.entry(child).or_insert(parent);
+        }
+    }
+
+    pub(crate) fn record_title(&mut self, thread_id: ThreadId, title: Option<&str>) {
+        if let Some(title) = title
+            .and_then(|s| s.lines().next())
+            .map(str::trim)
+            .filter(|s| !s.is_empty())
+        {
+            self.titles
+                .insert(thread_id, title.chars().take(160).collect());
+        }
+    }
+
+    pub(crate) fn record_spawn_prompt(&mut self, thread_id: ThreadId, prompt: Option<&str>) {
+        if !self.titles.contains_key(&thread_id) {
+            self.record_title(thread_id, prompt);
+        }
+    }
+
+    pub(crate) fn record_thread_status(
+        &mut self,
+        thread_id: ThreadId,
+        status: &codex_app_server_protocol::ThreadStatus,
+    ) {
+        let waiting = matches!(status, codex_app_server_protocol::ThreadStatus::Active { active_flags }
+            if active_flags.iter().any(|flag| matches!(flag,
+                codex_app_server_protocol::ThreadActiveFlag::WaitingOnApproval |
+                codex_app_server_protocol::ThreadActiveFlag::WaitingOnUserInput)));
+        if waiting && !self.stopped_threads.contains(&thread_id) {
+            self.server_waiting_threads.insert(thread_id);
+        } else {
+            self.server_waiting_threads.remove(&thread_id);
+        }
+    }
+
+    pub(crate) fn record_thread_metadata(&mut self, thread: &codex_app_server_protocol::Thread) {
+        let Ok(id) = ThreadId::from_string(&thread.id) else {
+            return;
+        };
+        let parent = thread
+            .parent_thread_id
+            .as_deref()
+            .and_then(|id| ThreadId::from_string(id).ok())
+            .or_else(|| match &thread.source {
+                codex_app_server_protocol::SessionSource::SubAgent(
+                    codex_protocol::protocol::SubAgentSource::ThreadSpawn {
+                        parent_thread_id, ..
+                    },
+                ) => Some(*parent_thread_id),
+                _ => None,
+            });
+        if let Some(parent) = parent {
+            self.parents.insert(id, parent);
+        }
+        self.record_title(id, thread.name.as_deref());
+        self.record_thread_status(id, &thread.status);
+    }
+
+    pub(crate) fn roster(
+        &self,
+        primary: Option<ThreadId>,
+        displayed: Option<ThreadId>,
+    ) -> crate::agent_roster::AgentRoster {
+        let Some(primary) = primary else {
+            return Default::default();
+        };
+        let is_descendant = |id: ThreadId| {
+            let mut current = id;
+            let mut visited = HashSet::new();
+            while visited.insert(current) {
+                let Some(parent) = self.parents.get(&current) else {
+                    return false;
+                };
+                if *parent == primary {
+                    return true;
+                }
+                current = *parent;
+            }
+            false
+        };
+        let descendants: Vec<_> = self
+            .visible_threads()
+            .into_iter()
+            .filter(|(id, _)| *id != primary && is_descendant(*id))
+            .collect();
+        if descendants.is_empty() {
+            return Default::default();
+        }
+        let row = |id, label| {
+            let entry = self.get(&id);
+            crate::agent_roster::AgentRosterRow {
+                label,
+                selected: displayed == Some(id),
+                status: if entry.is_some_and(|e| e.is_closed) {
+                    crate::agent_roster::AgentRosterStatus::Closed
+                } else if self.pending_interactions.contains(&id)
+                    || self.server_waiting_threads.contains(&id)
+                {
+                    crate::agent_roster::AgentRosterStatus::Waiting
+                } else if entry.is_some_and(|e| e.is_running) {
+                    crate::agent_roster::AgentRosterStatus::Running
+                } else {
+                    crate::agent_roster::AgentRosterStatus::Idle
+                },
+            }
+        };
+        let mut rows = vec![row(primary, "Main".to_string())];
+        rows.extend(descendants.into_iter().map(|(id, entry)| {
+            let label = entry
+                .agent_path
+                .as_deref()
+                .and_then(|path| path.rsplit('/').find(|s| !s.trim().is_empty()))
+                .map(|slug| slug.replace('_', " "))
+                .or_else(|| self.titles.get(&id).cloned())
+                .unwrap_or_else(|| {
+                    let label = format_agent_picker_item_name(
+                        entry.agent_nickname.as_deref(),
+                        entry.agent_role.as_deref(),
+                        false,
+                    );
+                    if label == "Agent" {
+                        format!("Agent {}", &id.to_string()[28..])
+                    } else {
+                        label
+                    }
+                });
+            row(id, label)
+        }));
+        crate::agent_roster::AgentRoster::new(rows)
+    }
