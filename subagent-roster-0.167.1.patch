+use crate::line_truncation::truncate_line_with_ellipsis_if_overflow;
+use crate::render::renderable::Renderable;
+use ratatui::buffer::Buffer;
+use ratatui::layout::Rect;
+use ratatui::style::Stylize;
+use ratatui::text::Line;
+use ratatui::text::Span;
+use ratatui::widgets::Widget;
+
+const MAX_CHILDREN: usize = 5;
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub(crate) enum AgentRosterStatus {
+    Running,
+    Waiting,
+    Idle,
+    Closed,
+}
+
+impl AgentRosterStatus {
+    fn priority(self) -> u8 {
+        match self {
+            Self::Running => 0,
+            Self::Waiting => 1,
+            Self::Idle => 2,
+            Self::Closed => 3,
+        }
+    }
+
+    fn span(self) -> Span<'static> {
+        match self {
+            Self::Running => "Running".yellow(),
+            Self::Waiting => "Waiting".yellow(),
+            Self::Idle => "Idle".dim(),
+            Self::Closed => "Closed".dim(),
+        }
+    }
+}
+
+#[derive(Debug, PartialEq, Eq)]
+pub(crate) struct AgentRosterRow {
+    pub(crate) label: String,
+    pub(crate) status: AgentRosterStatus,
+    pub(crate) selected: bool,
+}
+
+#[derive(Debug, Default, PartialEq, Eq)]
+pub(crate) struct AgentRoster {
+    pub(crate) rows: Vec<AgentRosterRow>,
+}
+
+impl AgentRoster {
+    pub(crate) fn new(mut rows: Vec<AgentRosterRow>) -> Self {
+        if rows.len() > 1 {
+            rows[1..].sort_by_key(|row| row.status.priority());
+        }
+        Self { rows }
+    }
+
+    fn lines(&self, width: u16, height: u16) -> Vec<Line<'static>> {
+        if self.rows.len() <= 1 || width == 0 || height == 0 {
+            return Vec::new();
+        }
+        let capacity = usize::from(height).min(MAX_CHILDREN + 2);
+        let visible = if self.rows.len() <= capacity && self.rows.len() <= MAX_CHILDREN + 1 {
+            self.rows.len()
+        } else {
+            capacity.saturating_sub(1).min(MAX_CHILDREN + 1)
+        };
+        let mut visible_rows: Vec<_> = self.rows.iter().take(visible).collect();
+        if visible > 1
+            && let Some(selected_index) = self.rows.iter().position(|row| row.selected)
+            && selected_index >= visible
+        {
+            visible_rows[visible - 1] = &self.rows[selected_index];
+        }
+        let mut lines: Vec<_> = visible_rows
+            .into_iter()
+            .map(|row| {
+                let status = row.status.span();
+                let prefix = if row.selected { "› " } else { "  " };
+                let label = truncate_line_with_ellipsis_if_overflow(
+                    Line::from(vec![prefix.into(), row.label.clone().into()]),
+                    usize::from(width).saturating_sub(status.width() + 2),
+                );
+                let mut spans = label.spans;
+                spans.push("  ".into());
+                spans.push(status);
+                truncate_line_with_ellipsis_if_overflow(Line::from(spans), usize::from(width))
+            })
+            .collect();
+        if visible < self.rows.len() {
+            let hidden = self.rows.len() - visible.max(1);
+            let text = if visible == 0 {
+                let noun = if hidden == 1 { "agent" } else { "agents" };
+                format!("  {hidden} {noun}")
+            } else {
+                format!("  +{hidden} more")
+            };
+            lines.push(truncate_line_with_ellipsis_if_overflow(
+                Line::from(text.dim()),
+                usize::from(width),
+            ));
+        }
+        lines
+    }
+}
+
+impl Renderable for AgentRoster {
+    fn desired_height(&self, width: u16) -> u16 {
+        if self.rows.len() <= 1 || width == 0 {
+            0
+        } else {
+            self.rows.len().min(MAX_CHILDREN + 2) as u16
+        }
+    }
+
+    fn render(&self, area: Rect, buf: &mut Buffer) {
+        for (line, y) in self
+            .lines(area.width, area.height)
+            .into_iter()
+            .zip(area.y..area.bottom())
+        {
+            Widget::render(line, Rect::new(area.x, y, area.width, 1), buf);
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::line_truncation::line_width;
+
+    fn roster(children: usize) -> AgentRoster {
+        AgentRoster::new(
+            (0..=children)
+                .map(|i| AgentRosterRow {
+                    label: if i == 0 {
+                        "Main".into()
+                    } else {
+                        format!("分析 👩‍💻 e\u{301} {i}")
+                    },
+                    selected: i == 0,
+                    status: AgentRosterStatus::Running,
+                })
+                .collect(),
+        )
+    }
+
+    #[test]
+    fn roster_hides_without_children_and_bounds_overflow() {
+        assert_eq!(roster(0).desired_height(80), 0);
+        assert_eq!(roster(1).lines(80, 1)[0].to_string(), "  1 agent");
+        assert_eq!(
+            roster(6).lines(80, 7).last().unwrap().to_string(),
+            "  +1 more"
+        );
+        let roster = roster(9);
+        assert_eq!(roster.desired_height(80), 7);
+        let lines = roster.lines(80, 7);
+        assert_eq!(lines.len(), 7);
+        assert_eq!(lines.last().unwrap().to_string(), "  +4 more");
+        assert_eq!(roster.lines(80, 3).last().unwrap().to_string(), "  +8 more");
+        assert_eq!(roster.lines(80, 1)[0].to_string(), "  9 agents");
+    }
+
+    #[test]
+    fn roster_active_workers_precede_closed_overflow_and_selected_stays_visible() {
+        let roster = AgentRoster::new(vec![
+            AgentRosterRow {
+                label: "Main".into(),
+                status: AgentRosterStatus::Running,
+                selected: false,
+            },
+            AgentRosterRow {
+                label: "closed-0".into(),
+                status: AgentRosterStatus::Closed,
+                selected: false,
+            },
+            AgentRosterRow {
+                label: "closed-1".into(),
+                status: AgentRosterStatus::Closed,
+                selected: false,
+            },
+            AgentRosterRow {
+                label: "closed-2".into(),
+                status: AgentRosterStatus::Closed,
+                selected: false,
+            },
+            AgentRosterRow {
+                label: "closed-3".into(),
+                status: AgentRosterStatus::Closed,
+                selected: false,
+            },
+            AgentRosterRow {
+                label: "closed-4".into(),
+                status: AgentRosterStatus::Closed,
+                selected: false,
+            },
+            AgentRosterRow {
+                label: "closed-5".into(),
+                status: AgentRosterStatus::Closed,
+                selected: true,
+            },
+            AgentRosterRow {
+                label: "waiting".into(),
+                status: AgentRosterStatus::Waiting,
+                selected: false,
+            },
+            AgentRosterRow {
+                label: "running".into(),
+                status: AgentRosterStatus::Running,
+                selected: false,
+            },
+        ]);
+
+        assert_eq!(roster.rows[0].label, "Main");
+        assert_eq!(roster.rows[1].label, "running");
+        assert_eq!(roster.rows[2].label, "waiting");
+        assert_eq!(roster.rows[3].label, "closed-0");
+        assert_eq!(roster.rows[4].label, "closed-1");
+        let lines = roster.lines(80, 7);
+        let rendered = lines.iter().map(ToString::to_string).collect::<Vec<_>>();
+        assert!(rendered[1].contains("running"));
+        assert!(rendered[2].contains("waiting"));
+        assert!(rendered.iter().any(|line| line.contains("› closed-5")));
+        assert_eq!(rendered.last().unwrap(), "  +3 more");
+    }
+
+    #[test]
+    fn roster_clips_unicode_without_wrapping() {
+        for width in 0..30 {
+            let lines = roster(2).lines(width, 7);
+            assert!(
+                lines
+                    .iter()
+                    .all(|line| line_width(line) <= usize::from(width))
+            );
+            let area = Rect::new(0, 0, width, 3);
+            roster(2).render(area, &mut Buffer::empty(area));
+        }
+    }
+}
