diff --git a/codex-rs/tui/src/chatwidget/rendering_tests.rs b/codex-rs/tui/src/chatwidget/rendering_tests.rs
index 28108e895..71ac0afa4 100644
--- a/codex-rs/tui/src/chatwidget/rendering_tests.rs
+++ b/codex-rs/tui/src/chatwidget/rendering_tests.rs
@@ -644,3 +644,50 @@ async fn provider_error_preserves_draft_and_survives_thread_navigation() {
     }
     insta::assert_snapshot!("provider_errors", snapshots.join("\n\n"));
 }
+
+#[tokio::test]
+async fn agent_roster_preserves_composer_cursor_and_shrinks_on_short_panes() {
+    use crate::agent_roster::AgentRoster;
+    use crate::agent_roster::AgentRosterRow;
+    use crate::agent_roster::AgentRosterStatus;
+    use crate::bottom_pane::ComposerRenderOptions;
+
+    let (mut widget, _sender, _events, _operations) = make_chatwidget_manual_with_sender().await;
+    widget.handle_paste("draft stays here".into());
+    let roster = AgentRoster::new(vec![
+        AgentRosterRow {
+            label: "Main".into(),
+            selected: true,
+            status: AgentRosterStatus::Running,
+        },
+        AgentRosterRow {
+            label: "Inspect rendering".into(),
+            selected: false,
+            status: AgentRosterStatus::Idle,
+        },
+    ]);
+    let plain = widget.bottom_pane_renderable(ComposerRenderOptions::default());
+    let bottom = widget.bottom_pane_renderable(ComposerRenderOptions {
+        agent_roster: Some(&roster),
+        ..Default::default()
+    });
+    let height = plain.desired_height(60);
+    assert_eq!(bottom.desired_height(60), height + 2);
+    let plain_area = Rect::new(0, 0, 60, height);
+    let full_area = Rect::new(0, 0, 60, height + 2);
+    assert_eq!(plain.cursor_pos(plain_area), bottom.cursor_pos(full_area));
+    let mut buffer = Buffer::empty(full_area);
+    bottom.render(full_area, &mut buffer);
+    assert!(contains_text(&buffer, "draft stays here"));
+    assert!(contains_text(&buffer, "Inspect rendering"));
+    let mut short = Buffer::empty(plain_area);
+    bottom.render(plain_area, &mut short);
+    assert!(contains_text(&short, "draft stays here"));
+    assert_eq!(plain.cursor_pos(plain_area), bottom.cursor_pos(plain_area));
+    let inline = widget.as_renderable_with_roster(Some(&roster));
+    let inline_area = Rect::new(0, 0, 60, inline.desired_height(60));
+    let mut inline_buffer = Buffer::empty(inline_area);
+    inline.render(inline_area, &mut inline_buffer);
+    assert!(contains_text(&inline_buffer, "Inspect rendering"));
+    assert!(inline.cursor_pos(inline_area).is_some());
+}
